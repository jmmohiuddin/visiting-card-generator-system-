# Copy to .env and fill in. NEVER commit the real value.
# Set the real one in Netlify: Site settings → Environment variables → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Accounts (PRD Epic G) ────────────────────────────────────────────────
# Signs and verifies session tokens. At least 32 characters, from a real
# random source: `openssl rand -hex 32`. Rotating it signs everybody out,
# which is the intended emergency lever. Without it, /api/auth answers 503
# in production rather than inventing a key nobody can revoke.
AUTH_SECRET=""

# Keys the HMAC that one-time codes are stored under, so a dump of auth_otps
# is not a list of working codes. Separate from AUTH_SECRET so a leak of one
# is not a leak of both; falls back to AUTH_SECRET when unset.
OTP_PEPPER=""

# SMS gateway. Bangladeshi delivery goes through a local aggregator, not
# Twilio. These are the BulkSMSBD-shaped parameters; SMS_API_URL only needs
# setting for a provider that clones the shape at a different host.
# With SMS_API_KEY or SMS_SENDER_ID missing, the development transport is
# used instead — it refuses to run under NODE_ENV=production.
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_API_URL="https://bulksmsbd.net/api/smsapi"

# ── Payments (PRD Epic F) ────────────────────────────────────────────────
# Money is only ever taken at proof approval. These credentials are what make
# that real; without them every rail runs its simulated transport, which moves
# nothing and refuses to run under NODE_ENV=production.

# bKash Tokenized Checkout. Issued per merchant from the bKash merchant
# portal; the sandbox set and the live set are different values. BKASH_MODE is
# "sandbox" (default) or "live", and BKASH_BASE_URL only needs setting if bKash
# moves the path again — it has once already.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_MODE="sandbox"
BKASH_BASE_URL=""

# Nagad Online Payment Gateway. NAGAD_PRIVATE_KEY is the merchant's own RSA
# private key — it signs every request, so treat it exactly as you would the
# database password. NAGAD_PUBLIC_KEY is Nagad's public key, used to encrypt
# what we send them. Both may be pasted as bare base64 without PEM armour.
# NAGAD_SIGN_ALG exists because Nagad's guide says SHA1withRSA while every
# working merchant integration signs SHA256; leave it unset unless a live
# account disagrees.
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_NUMBER=""
NAGAD_PRIVATE_KEY=""
NAGAD_PUBLIC_KEY=""
NAGAD_MODE="sandbox"
NAGAD_BASE_URL=""
NAGAD_API_VERSION="v-0.2.0"
NAGAD_SIGN_ALG=""

# Recording a cash settlement and issuing a refund are staff actions, not
# customer ones. Real staff accounts arrive with the accounts work; until then
# this shared token gates both, and a deploy that leaves it empty refuses them
# outright rather than leaving them open. `openssl rand -hex 32`.
CARDWORKS_STAFF_TOKEN=""

# Absolute origin of the deployed site, used to build the provider callback
# the customer is returned to. Without it the callback is a relative path,
# which bKash and Nagad will not accept.
PUBLIC_BASE_URL=""
